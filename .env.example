# ---------- Imagem (OpenAI) ----------
OPENAI_API_KEY=sk-...
# gpt-image-1 (padrão, 1024x1536) ou dall-e-3 (1024x1792)
OPENAI_IMAGE_MODEL=gpt-image-1
# opcional: gpt-image-1 -> low|medium|high ; dall-e-3 -> standard|hd
OPENAI_IMAGE_QUALITY=

# ---------- Vídeo (Image-to-Video) ----------
# fal | replicate | generic
VIDEO_PROVIDER=fal
VIDEO_API_KEY=
# Fal:       fal-ai/kling-video/v2.1/standard/image-to-video  (ou wan, minimax, etc.)
# Replicate: kwaivgi/kling-v2.1   (ou owner/name:versionhash)
VIDEO_MODEL=fal-ai/kling-video/v2.1/standard/image-to-video
# Só para VIDEO_PROVIDER=generic (POST síncrono que devolve a URL do vídeo)
VIDEO_API_ENDPOINT=
# JSON mesclado no corpo da requisição (campos específicos do modelo)
VIDEO_EXTRA_INPUT={}
VIDEO_TIMEOUT_MS=900000
VIDEO_POLL_INTERVAL_MS=5000

# ---------- Saída ----------
# relativo à raiz do projeto (ou caminho absoluto)
OUTPUT_DIR=output
