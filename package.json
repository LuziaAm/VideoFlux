{
  "name": "fluxvideo",
  "version": "1.0.0",
  "description": "Servidor MCP local: imagem (OpenAI) -> vídeo I2V (Fal/Replicate) -> montagem final, para Claude Desktop",
  "main": "dist/server.js",
  "bin": { "flux-video-mcp": "dist/server.js" },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/server.js",
    "inspect": "npx -y @modelcontextprotocol/inspector node dist/server.js"
  },
  "keywords": ["mcp", "claude", "video", "image-to-video"],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "axios": "^1.21.0",
    "ffmpeg-static": "^5.3.0",
    "openai": "^7.45.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
